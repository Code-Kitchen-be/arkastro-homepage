{
  "name": "arkastro",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev:homepage": "npm run dev -w @arkastro/homepage",
    "build:homepage": "npm run build -w @arkastro/homepage",
    "dev:shop": "npm run dev -w @arkastro/shop",
    "build:shop": "npm run build -w @arkastro/shop",
    "dev:medusa": "npm run dev -w @arkastro/medusa",
    "build:medusa": "npm run build -w @arkastro/medusa",
    "seed:lab": "npm run seed -w @arkastro/medusa",
    "build": "npm run build:homepage",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down"
  }
}

