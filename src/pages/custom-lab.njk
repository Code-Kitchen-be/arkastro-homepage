    <!-- Contact CTA -->
    <section class="bg-gold text-marine py-20">
        <div class="container mx-auto px-6">
            <div class="max-w-4xl mx-auto text-center">
                <h2 class="text-3xl md:text-4xl font-bold mb-4">Uw ontwerp laten realiseren?</h2>
                <p class="text-marine/90 mb-10 leading-relaxed">
                    Heeft u een concept dat u wilt laten 3D-printen, lasercutten of ontwerpen? Wij staan klaar om van uw idee een tastbaar resultaat te maken. Stuur ons een bericht met uw wensen.
                </p>
                <a href="contact.html?onderwerp=lab" class="bg-marine text-white font-bold py-4 px-10 rounded-full hover:bg-marine/90 transition duration-300 shadow-xl inline-flex items-center justify-center">
                    Stuur ons uw aanvraag
                </a>
            </div>
        </div>
    </section>

    <!-- Portfolio -->
    <section id="portfolio" class="scroll-mt-24 py-24 container mx-auto px-6">
        <div class="max-w-6xl mx-auto">
            <div class="text-center mb-12">
                <h2 class="text-3xl md:text-4xl font-bold mb-4 underline decoration-gold decoration-4 underline-offset-8">Portfolio</h2>
                <p class="text-gray-600 max-w-3xl mx-auto">
                    Een selectie van projecten uit ons lab.
                </p>
            </div>

            <div class="space-y-8 mb-12">
                {% for project in labProjects %}
                    {% if project.layout == "featured" and not project.afterCompact %}
                        {% set reverse = loop.index0 % 2 == 1 %}
                        {% include "lab-project-featured.njk" %}
                    {% endif %}
                {% endfor %}
            </div>

            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
                {% for project in labProjects %}
                    {% if project.layout != "featured" %}
                        {% include "lab-project-compact.njk" %}
                    {% endif %}
                {% endfor %}
            </div>

            <div class="space-y-8">
                {% for project in labProjects %}
                    {% if project.layout == "featured" and project.afterCompact %}
                        {% set reverse = true %}
                        {% include "lab-project-featured.njk" %}
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Binnenkort -->
    <section class="py-24 container mx-auto px-6">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-3xl font-bold mb-4 underline decoration-gold decoration-4 underline-offset-8">Binnenkort</h2>
            <p class="text-gray-600 text-lg">
                Binnenkort: Onze eigen webshop met exclusieve (boekgerelateerde) 3D-creaties en gadgets.
            </p>
        </div>
    </section>
