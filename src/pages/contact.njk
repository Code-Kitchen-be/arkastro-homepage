---
layout: base.njk
title: "Contact | ArkAstro"
description: "Neem contact op met ArkAstro — IT, Custom Lab of een algemene vraag."
permalink: /contact.html
activeNav: null
---
    <!-- Hero -->
    <header class="bg-marine text-white px-6 py-16 md:py-20 relative overflow-hidden">
        <div class="absolute inset-0 pointer-events-none" style="background:
            radial-gradient(1000px 500px at 15% 20%, rgba(212, 175, 55, 0.20), transparent 60%),
            radial-gradient(800px 400px at 85% 75%, rgba(255, 255, 255, 0.08), transparent 55%);"></div>
        <div class="container mx-auto relative z-10 max-w-3xl text-center">
            <p class="text-sm font-bold uppercase tracking-widest text-gold mb-4">ArkAstro</p>
            <h1 class="text-4xl md:text-5xl font-bold mb-4 pb-1 gold-gradient leading-[1.1]">Contact</h1>
            <p class="text-base md:text-lg max-w-2xl mx-auto text-gray-200 leading-relaxed">
                Vertel ons kort waar we mee kunnen helpen. We antwoorden zo snel mogelijk.
            </p>
        </div>
    </header>

    <!-- Form -->
    <section class="py-16 md:py-20 container mx-auto px-6">
        <div class="max-w-3xl mx-auto">
            <form id="contact-form" class="space-y-10" novalidate
                  data-api-url="https://mailer.arkastro.be/mail/send">
                <!-- Honeypot -->
                <div class="absolute -left-[9999px] top-auto h-0 w-0 overflow-hidden" aria-hidden="true">
                    <label for="website">Website</label>
                    <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
                </div>

                <fieldset class="bg-white rounded-3xl border-t-8 border-gold shadow-sm p-8 md:p-10">
                    <legend class="sr-only">Uw bericht</legend>
                    <h2 class="text-xl md:text-2xl font-bold mb-2">
                        <span class="text-gold mr-2">1.</span>Uw gegevens
                    </h2>
                    <p class="text-gray-500 text-sm mb-8">Zodat we u kunnen bereiken.</p>

                    <div class="grid gap-6">
                        <div class="grid md:grid-cols-2 gap-6">
                            <div>
                                <label for="naam" class="block text-sm font-bold text-marine mb-2">Naam <span class="text-gold">*</span></label>
                                <input type="text" id="naam" name="naam" required autocomplete="name"
                                       class="form-input w-full rounded-xl border border-black/10 bg-gray-50 px-4 py-3 text-marine focus:outline-none focus:ring-2 focus:ring-gold/60 focus:border-gold" />
                            </div>
                            <div>
                                <label for="email" class="block text-sm font-bold text-marine mb-2">E-mailadres <span class="text-gold">*</span></label>
                                <input type="email" id="email" name="email" required autocomplete="email"
                                       class="form-input w-full rounded-xl border border-black/10 bg-gray-50 px-4 py-3 text-marine focus:outline-none focus:ring-2 focus:ring-gold/60 focus:border-gold" />
                            </div>
                        </div>
                        <div>
                            <label for="telefoon" class="block text-sm font-bold text-marine mb-2">Telefoonnummer</label>
                            <input type="tel" id="telefoon" name="telefoon" autocomplete="tel"
                                   class="form-input w-full rounded-xl border border-black/10 bg-gray-50 px-4 py-3 text-marine focus:outline-none focus:ring-2 focus:ring-gold/60 focus:border-gold" />
                        </div>
                    </div>
                </fieldset>

                <fieldset class="bg-white rounded-3xl border-t-8 border-gold shadow-sm p-8 md:p-10">
                    <legend class="sr-only">Bericht</legend>
                    <h2 class="text-xl md:text-2xl font-bold mb-2">
                        <span class="text-gold mr-2">2.</span>Uw vraag
                    </h2>
                    <p class="text-gray-500 text-sm mb-8">Kies een onderwerp en beschrijf kort wat u nodig heeft.</p>

                    <div class="grid gap-6">
                        <div>
                            <label for="onderwerp" class="block text-sm font-bold text-marine mb-2">Onderwerp <span class="text-gold">*</span></label>
                            <select id="onderwerp" name="onderwerp" required
                                    class="form-input w-full rounded-xl border border-black/10 bg-gray-50 px-4 py-3 text-marine focus:outline-none focus:ring-2 focus:ring-gold/60 focus:border-gold">
                                <option value="">Kies een onderwerp…</option>
                                <option value="it">Digitaal Maatwerk &amp; AI</option>
                                <option value="lab">Custom Lab (3D &amp; laser)</option>
                                <option value="algemeen">Algemene vraag</option>
                                <option value="ander">Anders</option>
                            </select>
                        </div>
                        <div>
                            <label for="bericht" class="block text-sm font-bold text-marine mb-2">Bericht <span class="text-gold">*</span></label>
                            <textarea id="bericht" name="bericht" rows="6" required
                                      class="form-input w-full rounded-xl border border-black/10 bg-gray-50 px-4 py-3 text-marine focus:outline-none focus:ring-2 focus:ring-gold/60 focus:border-gold"
                                      placeholder="Beschrijf kort uw project of vraag…"></textarea>
                        </div>
                    </div>
                </fieldset>

                <div id="form-status" class="hidden rounded-2xl px-5 py-4 text-sm font-medium" role="status" aria-live="polite"></div>

                <div class="flex flex-col sm:flex-row gap-4 sm:items-center sm:justify-between pt-2">
                    <p class="text-xs text-gray-500">
                        Velden met <span class="text-gold font-bold">*</span> zijn verplicht.
                        Uw bericht wordt per e-mail doorgestuurd naar ArkAstro.
                    </p>
                    <button type="submit" id="contact-submit"
                            class="bg-marine text-white font-bold py-4 px-10 rounded-full hover:bg-marine/90 transition duration-300 shadow-xl inline-flex items-center justify-center whitespace-nowrap disabled:opacity-60 disabled:cursor-not-allowed">
                        <span class="submit-label">Verstuur bericht</span>
                        <span class="ml-2" aria-hidden="true">→</span>
                    </button>
                </div>
            </form>
        </div>
    </section>
